[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "upstream"]
	url = https://github.com/krishnaagarwal781/Recipe_Social.git
	fetch = +refs/heads/*:refs/remotes/upstream/*
[branch "main"]
	remote = upstream
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "Alfisha"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/Alfisha
[remote "origin"]
	url = https://github.com/Alfisha-Anjum/Recipe_Social.git
	fetch = +refs/heads/*:refs/remotes/origin/*
